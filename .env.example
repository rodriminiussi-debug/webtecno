# ---------------------------------------------------------------
# MONO store — variables de entorno
# Sin ninguna variable, la tienda corre en "modo local": los datos
# viven en .data/db.json y se siembran con el catálogo demo.
# ---------------------------------------------------------------

# URL pública del sitio (SEO, sitemap, Open Graph, callbacks de pago)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sesión del panel /admin (obligatoria en producción: 32+ caracteres aleatorios)
SESSION_SECRET=

# Administrador inicial (se crea sólo si no existe ningún usuario)
ADMIN_EMAIL=admin@mono.store
ADMIN_PASSWORD=

# --- Supabase (opcional). Si están definidas, reemplazan al modo local ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media

# --- Pagos (opcionales). Cada proveedor se habilita sólo si tiene su clave ---
MERCADOPAGO_ACCESS_TOKEN=
STRIPE_SECRET_KEY=
